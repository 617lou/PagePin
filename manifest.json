{
  "manifest_version": 3,
  "name": "PagePin",
  "version": "0.1.4",
  "description": "Pin text annotations to HTML elements and export self-contained annotated pages.",
  "permissions": ["activeTab", "downloads", "scripting", "storage"],
  "host_permissions": ["file:///*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PagePin",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer-runtime.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
